# Django
DJANGO_SECRET_KEY=change-me-in-production
# SECRET_KEY= (alias legado, opcional)
DJANGO_DEBUG=True
# DEBUG= (alias legado, opcional)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (en desarrollo, origen del frontend)
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Cache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=piloto-mapa
CACHE_DEFAULT_TIMEOUT=300
PROVINCIAS_CACHE_TTL=86400
GEOCODIFICACION_CACHE_TTL=86400

# Throttling
THROTTLE_RATE=30/min

# Georef
GEOREF_BASE_URL=https://apis.datos.gob.ar/georef/api/v2.0
GEOREF_TIMEOUT=8

# Nominatim/OpenStreetMap: fallback exacto y sugerencias de alturas vecinas.
# Usar un User-Agent identificable y respetar el límite público de 1 req/s.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT=8
NOMINATIM_USER_AGENT=GeoHuella/0.1 (educational address lookup; contact: you@example.org)
# Intervalo mínimo global entre consultas a Nominatim (segundos).
NOMINATIM_RATE_LIMIT_SECONDS=1.1
# Presupuesto máximo para probar alturas vecinas. 0 = sin límite.
NOMINATIM_NEARBY_BUDGET_SECONDS=6.0
# Archivo de lock compartido entre procesos. Vacío = temporal del sistema.
NOMINATIM_RATE_LOCK_FILE=


# HERE Geocoding & Search (fallback opcional; API key solo en backend)
HERE_API_KEY=
HERE_ENABLED=false
HERE_TIMEOUT=8
HERE_MIN_SCORE=0.8
HERE_CACHE_TTL=86400


# Rutas: HeiGIT/OpenRouteService Directions v2 + VROOM (solo backend)
# Crear una API key gratuita en https://account.heigit.org/
ROUTING_ENABLED=false
ROUTING_API_KEY=
ROUTING_BASE_URL=https://api.heigit.org/openrouteservice/v2/directions
ROUTING_OPTIMIZATION_URL=https://api.heigit.org/vroom/v0
ROUTING_TIMEOUT=10
ROUTING_CACHE_TTL=300
