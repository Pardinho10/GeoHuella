# Base URL del backend (sin barra final). Vacío = mismo origen.
VITE_API_BASE_URL=http://localhost:8001
# Usar mocks en lugar del backend real: true|false
VITE_USAR_MOCK=false

# Estilo vectorial de MapLibre GL JS.
# OpenFreeMap no requiere API key; atribución automática en el mapa.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
